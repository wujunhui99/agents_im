Name: apigateway
Host: 127.0.0.1
Port: ${GATEWAY_HTTP_PORT}

# 单一 HTTP 入口：8 个域在同一个进程内装配（本地 dev）。
User:
  Auth:
    AccessSecret: ${JWT_ACCESS_SECRET}
    AccessExpire: ${JWT_ACCESS_EXPIRE}
  UserRPC:
    Endpoints:
      - 127.0.0.1:${USER_RPC_PORT}
    Timeout: 5000
  Redis:
    Addr: ${REDIS_ADDR}
    Password: ${REDIS_PASSWORD}
    DB: ${REDIS_DB}

AuthAPI:
  Auth:
    AccessSecret: ${JWT_ACCESS_SECRET}
    AccessExpire: ${JWT_ACCESS_EXPIRE}
  AuthRPC:
    Endpoints:
      - 127.0.0.1:${AUTH_RPC_PORT}
    Timeout: 5000

