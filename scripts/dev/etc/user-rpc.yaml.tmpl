Name: user-rpc
ListenOn: 127.0.0.1:${USER_RPC_PORT}
DataSource: ${DATABASE_URL}
ResourceRPC:
  Endpoints:
    - 127.0.0.1:${RESOURCE_RPC_PORT}
  Timeout: 5000
# 事件出口：新账号创建后发布 user.created.v1（默认助手绑定/好友由 agent-rpc 消费）。
Kafka:
  Brokers: ${KAFKA_BROKERS}

Telemetry:
  Name: user-rpc
  Endpoint: 127.0.0.1:${TEMPO_OTLP_GRPC_PORT}
  Sampler: 1.0
  Batcher: otlpgrpc
